call DBMS_AI_SERVICE.DROP_AI_MODEL('ollama_embed');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('complete_openai', '{"type":"completion","model_name":"gpt-test"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('embed_openai', '{"type":"dense_embedding","model_name":"embed-test"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('rerank_model', '{"type":"rerank","model_name":"rerank-test"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('ollama_complete', '{"type":"completion","model_name":"llama3.1"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('ollama_embed', '{"type":"dense_embedding","model_name":"nomic-embed"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('complete_ep', '{
  "ai_model_name":"complete_openai",
  "url":"http://127.0.0.1:8000/v1/chat/completions",
  "access_key":"sk-test",
  "provider":"openai",
  "request_model_name":"gpt-test"
}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('embed_ep', '{
  "ai_model_name":"embed_openai",
  "url":"http://127.0.0.1:8000/v1/embeddings",
  "access_key":"sk-test",
  "provider":"OPENAI",
  "request_model_name":"embed-test"
}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('rerank_ep', '{
  "ai_model_name":"rerank_model",
  "url":"http://127.0.0.1:8000/v1/rerank",
  "access_key":"sk-test",
  "provider":"siliconflow",
  "request_model_name":"rerank-test"
}');
