load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")

package(default_testonly = True)

cc_library(
    name = "ob_expr_ai_prompt_test_cases",
    srcs = ["ob_expr_ai_prompt_test.cpp"],
    alwayslink = True,
    deps = [
        "//bazel/third_party:gtest",
        "//src/sql:ai_expr_test_headers",
    ],
)

cc_test(
    name = "ob_expr_ai_prompt_test",
    size = "small",
    linkstatic = True,
    # liboceanbase supplies the C++ runtime. Use rules_cc's $ORIGIN rpath,
    # rather than its $EXEC_ORIGIN path for tests with static C++ runtimes.
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    deps = [
        ":ob_expr_ai_prompt_test_cases",
        "//src/observer:liboceanbase",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

cc_library(
    name = "test_ob_openai_utils_cases",
    srcs = ["test_ob_openai_utils.cpp"],
    alwayslink = True,
    deps = [
        "//bazel/third_party:gtest",
        "//src/sql:ai_expr_test_headers",
    ],
)

cc_test(
    name = "test_ob_openai_utils",
    size = "small",
    linkstatic = True,
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    deps = [
        ":test_ob_openai_utils_cases",
        "//src/observer:liboceanbase",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
